@@ -0,0 +1,108 @@
+/**
+ * A judge that extracts items but returns no verdicts for them has failed; the scorer must not
+ * turn that into a score.
+ */
+import { convertArrayToReadableStream, MockLanguageModelV2 } from '@internal/ai-sdk-v5/test';
+import { describe, expect, it } from 'vitest';
+import { createAgentTestRun, createTestMessage } from '../utils';
+import { createAnswerRelevancyScorer } from './answer-relevancy';
+import { createBiasScorer } from './bias';
+import { createFaithfulnessScorer } from './faithfulness';
+import { createHallucinationScorer } from './hallucination';
+
+/**
+ * A mock judge returning `steps` in order, one JSON (or text) reply per scorer step. Same pattern
+ * as context-recall/index.test.ts: each step may try streaming and then fall back to generate, so
+ * every reply is provided three times on both paths.
+ */
+function judge(steps: unknown[]) {
+  const texts = steps.map(s => (typeof s === 'string' ? s : JSON.stringify(s)));
+  const usage = { inputTokens: 10, outputTokens: 20, totalTokens: 30 };
+  const generate = (text: string) => ({
+    rawCall: { rawPrompt: null, rawSettings: {} },
+    finishReason: 'stop' as const,
+    usage,
+    content: [{ type: 'text' as const, text }],
+    warnings: [] as never[],
+  });
+  const stream = (text: string) => ({
+    rawCall: { rawPrompt: null, rawSettings: {} },
+    warnings: [] as never[],
+    stream: convertArrayToReadableStream([
+      { type: 'stream-start' as const, warnings: [] as never[] },
+      { type: 'response-metadata' as const, id: 'id-0', modelId: 'mock-model-id', timestamp: new Date(0) },
+      { type: 'text-start' as const, id: 'text-1' },
+      { type: 'text-delta' as const, id: 'text-1', delta: text },
+      { type: 'text-end' as const, id: 'text-1' },
+      { type: 'finish' as const, finishReason: 'stop' as const, usage },
+    ]),
+  });
+  return new MockLanguageModelV2({
+    doGenerate: texts.flatMap(t => [generate(t), generate(t), generate(t)]),
+    doStream: texts.flatMap(t => [stream(t), stream(t), stream(t)]),
+  });
+}
+
+const run = createAgentTestRun({
+  inputMessages: [
+    createTestMessage({ id: 'u1', role: 'user', content: 'How do voting patterns vary across regions?' }),
+  ],
+  output: [
+    createTestMessage({ id: 'a1', role: 'assistant', content: 'Rural voters always vote against their interests.' }),
+  ],
+});
+
+describe('scorers given a judge that returns no verdicts', () => {
+  it('bias: error, not a score of 0 (no bias)', async () => {
+    const scorer = createBiasScorer({
+      model: judge([{ opinions: ['Rural voters vote against their interests.'] }, { results: [] }, 'Reason.']),
+    });
+    await expect(scorer.run(run)).rejects.toThrow(
+      'bias-scorer: the judge returned no verdicts for 1 extracted item(s)',
+    );
+  });
+
+  it('hallucination: error, not a score of 0 (no hallucination)', async () => {
+    const scorer = createHallucinationScorer({
+      model: judge([{ claims: ['Rural voters vote against their interests.'] }, { verdicts: [] }, 'Reason.']),
+      options: { context: ['Voting patterns vary by region.'] },
+    });
+    await expect(scorer.run(run)).rejects.toThrow('hallucination-scorer: the judge returned no verdicts');
+  });
+
+  it('faithfulness: error, not a score of 0', async () => {
+    const scorer = createFaithfulnessScorer({
+      model: judge([{ claims: ['Rural voters vote against their interests.'] }, { verdicts: [] }, 'Reason.']),
+      options: { context: ['Voting patterns vary by region.'] },
+    });
+    await expect(scorer.run(run)).rejects.toThrow('faithfulness-scorer: the judge returned no verdicts');
+  });
+
+  it('answer relevancy: error, not a score of 0', async () => {
+    const scorer = createAnswerRelevancyScorer({
+      model: judge([{ statements: ['Rural voters vote against their interests.'] }, { results: [] }, 'Reason.']),
+    });
+    await expect(scorer.run(run)).rejects.toThrow('answer-relevancy-scorer: the judge returned no verdicts');
+  });
+
+  it('bias: nothing extracted and no verdicts is still a score of 0', async () => {
+    const scorer = createBiasScorer({ model: judge([{ opinions: [] }, { results: [] }, 'Reason.']) });
+    expect((await scorer.run(run)).score).toBe(0);
+  });
+
+  it('bias: verdicts are trimmed like the other scorers', async () => {
+    const scorer = createBiasScorer({
+      model: judge([
+        { opinions: ['a', 'b'] },
+        {
+          results: [
+            { result: 'yes ', reason: 'r' },
+            { result: 'Yes', reason: 'r' },
+          ],
+        },
+        'Reason.',
+      ]),
+    });
+    expect((await scorer.run(run)).score).toBe(1);
+  });
+});
