+/**
+ * Throws when the judge returned no verdicts for items the extraction step produced. An empty
+ * verdict list then means the judge failed, not that there was nothing to judge, so it is surfaced
+ * as a scorer error (like a structured-output validation failure) instead of becoming a score.
+ */
+export function assertJudgeReturnedVerdicts(scorerId: string, extracted: number, verdicts: number): void {
+  if (extracted > 0 && verdicts === 0) {
+    throw new Error(`${scorerId}: the judge returned no verdicts for ${extracted} extracted item(s)`);
+  }
+}
+
 export const roundToTwoDecimals = (num: number) => {
   return Math.round((num + Number.EPSILON) * 100) / 100;
 };
