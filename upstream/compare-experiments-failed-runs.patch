@@ -0,0 +1,141 @@
+/**
+ * compareExperiments through the real experiment runner, when target runs fail.
+ *
+ * Experiment scorers still run on a failed target, with empty output, and some score that as
+ * perfect. Those scores must not count as the agent's quality, and the failures must show up.
+ */
+import { describe, expect, it, vi } from 'vitest';
+import type { Agent } from '../../agent';
+import type { MastraScorer } from '../../evals/base';
+import type { Mastra } from '../../mastra';
+import type { MastraCompositeStore, StorageDomains } from '../../storage/base';
+import { DatasetsInMemory } from '../../storage/domains/datasets/inmemory';
+import { ExperimentsInMemory } from '../../storage/domains/experiments/inmemory';
+import { InMemoryDB } from '../../storage/domains/inmemory-db';
+import { ScoresInMemory } from '../../storage/domains/scores/inmemory';
+import { Dataset } from '../dataset';
+import { compareExperiments } from '../experiment/analytics/compare';
+
+// executeTarget checks the agent's model version; mock it so plain agent mocks work.
+vi.mock('../../agent', async importOriginal => {
+  const actual = (await importOriginal()) as Record<string, unknown>;
+  return { ...actual, isSupportedLanguageModel: vi.fn().mockReturnValue(true) };
+});
+
+/** An agent that fails when `fails(input, call)` says so; otherwise answers. */
+const agent = (id: string, fails: (input: string, call: number) => boolean): Agent => {
+  const calls = new Map<string, number>();
+  return {
+    id,
+    name: id,
+    getModel: vi.fn().mockResolvedValue({ specificationVersion: 'v2' }),
+    generate: vi.fn().mockImplementation(async (input: string) => {
+      const call = calls.get(input) ?? 0;
+      calls.set(input, call + 1);
+      if (fails(input, call)) throw new Error('503 upstream failure');
+      return { text: `answer to ${input}` };
+    }),
+  } as unknown as Agent;
+};
+
+/** Scores real output 0.5, and a failed run's empty output 1, as some prebuilt code scorers do. */
+const quality = {
+  id: 'quality',
+  name: 'quality',
+  description: 'test scorer',
+  run: vi.fn().mockImplementation(async ({ output }: { output?: unknown }) => ({
+    score: output ? 0.5 : 1,
+    reason: 'test',
+  })),
+} as unknown as MastraScorer<any, any, any, any>;
+
+async function setup(agents: Agent[]) {
+  const db = new InMemoryDB();
+  const datasetsStorage = new DatasetsInMemory({ db });
+  const experimentsStorage = new ExperimentsInMemory({ db });
+  const scoresStorage = new ScoresInMemory({ db });
+  const storage = {
+    id: 'test-storage',
+    stores: {
+      datasets: datasetsStorage,
+      experiments: experimentsStorage,
+      scores: scoresStorage,
+    } as unknown as StorageDomains,
+    getStore: vi
+      .fn()
+      .mockImplementation(async (name: keyof StorageDomains) =>
+        name === 'datasets'
+          ? datasetsStorage
+          : name === 'experiments'
+            ? experimentsStorage
+            : name === 'scores'
+              ? scoresStorage
+              : undefined,
+      ),
+  } as unknown as MastraCompositeStore;
+  const byId = (id: string) => agents.find(a => a.id === id) ?? null;
+  const mastra = {
+    getStorage: vi.fn().mockReturnValue(storage),
+    getLogger: vi.fn().mockReturnValue({ warn: vi.fn(), error: vi.fn(), info: vi.fn(), debug: vi.fn() }),
+    getAgent: vi.fn().mockImplementation(byId),
+    getAgentById: vi.fn().mockImplementation(byId),
+    getScorerById: vi.fn().mockImplementation((id: string) => (id === 'quality' ? quality : null)),
+    getWorkflowById: vi.fn(),
+    getWorkflow: vi.fn(),
+  } as unknown as Mastra;
+  const record = await datasetsStorage.createDataset({ name: 'failed runs' });
+  const itemIds: string[] = [];
+  for (const input of ['q1', 'q2', 'q3', 'q4'])
+    itemIds.push((await datasetsStorage.addItem({ datasetId: record.id, input })).id);
+  return { ds: new Dataset(record.id, mastra), mastra, itemIds };
+}
+
+describe('compareExperiments with failed target runs', () => {
+  it('a failed run scored as perfect does not raise the score, and the failure is reported', async () => {
+    const { ds, mastra } = await setup([agent('baseline', () => false), agent('candidate', input => input === 'q4')]);
+    const a = await ds.startExperiment({ targetType: 'agent', targetId: 'baseline', scorers: [quality] });
+    const b = await ds.startExperiment({ targetType: 'agent', targetId: 'candidate', scorers: [quality] });
+    expect(b.failedCount).toBe(1);
+
+    const result = await compareExperiments(mastra, { experimentIdA: a.experimentId, experimentIdB: b.experimentId });
+    expect(result.scorers.quality!.statsB.avgScore).toBeCloseTo(0.5, 10); // not (0.5 * 3 + 1) / 4
+    expect(result.scorers.quality!.delta).toBe(0);
+    expect(result.failedItems).toEqual({ a: 0, b: 1 });
+    expect(result.warnings).toContain(
+      '1 item(s) failed in experiment B that did not fail in A. A failed run has no comparable score, so score deltas alone can hide this.',
+    );
+    expect(result.hasRegression).toBe(false);
+
+    const gated = await compareExperiments(mastra, {
+      experimentIdA: a.experimentId,
+      experimentIdB: b.experimentId,
+      maxFailedItemIncrease: 0,
+    });
+    expect(gated.hasRegression).toBe(true);
+  });
+
+  it("a failed attempt's score is left out even when a retry of the item succeeded", async () => {
+    // The candidate's second attempt of every item fails; its empty output is scored 1.
+    const { ds, mastra, itemIds } = await setup([
+      agent('baseline', () => false),
+      agent('candidate', (_input, call) => call === 1),
+    ]);
+    const runs: Record<string, string> = {};
+    for (const target of ['baseline', 'candidate']) {
+      const { experimentId } = await ds.createExperiment({
+        targetType: 'agent',
+        targetId: target,
+        scorers: ['quality'],
+      });
+      for (const itemId of itemIds)
+        for (const attempt of [0, 1]) await ds.runExperimentItem({ experimentId, itemId, attempt });
+      await ds.finalizeExperiment({ experimentId });
+      runs[target] = experimentId;
+    }
+
+    const result = await compareExperiments(mastra, { experimentIdA: runs.baseline!, experimentIdB: runs.candidate! });
+    expect(result.scorers.quality!.statsB.avgScore).toBeCloseTo(0.5, 10); // not (0.5 + 1) / 2
+    expect(result.scorers.quality!.delta).toBe(0);
+    expect(result.failedItems).toEqual({ a: 0, b: 0 }); // every item has a successful attempt
+  });
+});
diff --git a/packages/core/src/datasets/experiment/analytics/__tests__/compare.test.ts b/packages/core/src/datasets/experiment/analytics/__tests__/compare.test.ts
