+++ b/packages/core/src/datasets/experiment/analytics/__tests__/compare.test.ts
@@ -0,0 +1,158 @@
+/**
+ * compareExperiments over stored rows: paired deltas, missing scorers, repeated attempts,
+ * and failed items.
+ */
+import { describe, expect, it } from 'vitest';
+import type { Mastra } from '../../../../mastra';
+import { compareExperiments } from '../compare';
+
+type Row = {
+  itemId: string;
+  attempt?: number;
+  error?: { message: string } | null;
+  scores?: Record<string, number | null>;
+};
+
+/** A Mastra stand-in whose storage holds two experiments, A and B. */
+function mastraWith(a: Row[], b: Row[]): Mastra {
+  const rows: Record<string, Row[]> = { A: a, B: b };
+  const experiments = {
+    getExperimentById: async ({ id }: { id: string }) => ({ id, datasetVersion: 1 }),
+    listExperimentResults: async ({ experimentId }: { experimentId: string }) => ({
+      results: rows[experimentId]!.map(r => ({ itemId: r.itemId, attempt: r.attempt ?? 0, error: r.error ?? null })),
+    }),
+  };
+  const scores = {
+    listScoresByRunId: async ({ runId }: { runId: string }) => ({
+      scores: rows[runId]!.flatMap(r =>
+        Object.entries(r.scores ?? {}).map(([scorerId, score]) => ({ scorerId, entityId: r.itemId, score })),
+      ),
+    }),
+  };
+  const storage = {
+    getStore: async (name: string) => (name === 'experiments' ? experiments : name === 'scores' ? scores : undefined),
+  };
+  return { getStorage: () => storage } as unknown as Mastra;
+}
+
+const ids = (n: number) => Array.from({ length: n }, (_, i) => `item-${i + 1}`);
+const quality = (i: number) => (i >= 7 ? 0.3 : 0.9); // last three items are hard
+const compare = (mastra: Mastra, extra: Record<string, unknown> = {}) =>
+  compareExperiments(mastra, { experimentIdA: 'A', experimentIdB: 'B', ...extra });
+
+describe('compareExperiments', () => {
+  it('identical experiments: no regression, no warnings', async () => {
+    const rows = ids(10).map((itemId, i) => ({ itemId, scores: { quality: quality(i) } }));
+    const result = await compare(mastraWith(rows, rows));
+    expect(result.hasRegression).toBe(false);
+    expect(result.scorers.quality!.delta).toBe(0);
+    expect(result.failedItems).toEqual({ a: 0, b: 0 });
+    expect(result.warnings).toEqual([]);
+  });
+
+  it('does not treat a scorer missing from one experiment as a score of 0', async () => {
+    const a = ids(5).map(itemId => ({ itemId, scores: { quality: 0.7, harm: 0.4 } }));
+    const b = ids(5).map(itemId => ({ itemId, scores: { quality: 0.7 } }));
+    const result = await compare(mastraWith(a, b), {
+      thresholds: { harm: { value: 0.05, direction: 'lower-is-better' } },
+    });
+    expect(result.scorers.harm!.missingIn).toBe('B');
+    expect(result.scorers.harm!.delta).toBe(0);
+    expect(result.scorers.harm!.regressed).toBe(false);
+    expect(result.hasRegression).toBe(true); // a scorer the candidate dropped fails the quick check
+    expect(result.warnings).toContain('Scorer "harm" has no scores in experiment B; it is not compared.');
+
+    const reversed = await compare(mastraWith(b, a), {
+      thresholds: { harm: { value: 0.05, direction: 'lower-is-better' } },
+    });
+    expect(reversed.scorers.harm!.missingIn).toBe('A');
+    expect(reversed.hasRegression).toBe(false);
+  });
+
+  it('treats a scorer whose rows are all null as missing', async () => {
+    const a = ids(3).map(itemId => ({ itemId, scores: { quality: 0.7, harm: null } }));
+    const b = ids(3).map(itemId => ({ itemId, scores: { quality: 0.7, harm: 0.2 } }));
+    const result = await compare(mastraWith(a, b));
+    expect(result.scorers.harm!.missingIn).toBe('A');
+    expect(result.warnings).toContain('Scorer "harm" has no scores in experiment A; it is not compared.');
+  });
+
+  it('averages repeated attempts of an item instead of keeping the last one', async () => {
+    const a = ids(4).map(itemId => ({ itemId, scores: { quality: 0.4 } }));
+    const b = ids(4).flatMap(itemId =>
+      [0.9, 0.1, 0.2].map((score, attempt) => ({ itemId, attempt, scores: { quality: score } })),
+    );
+    const result = await compare(mastraWith(a, b));
+    expect(result.scorers.quality!.statsB.avgScore).toBeCloseTo(0.4, 10);
+    expect(result.scorers.quality!.statsB.totalItems).toBe(4);
+    expect(result.scorers.quality!.delta).toBeCloseTo(0, 10);
+    expect(result.hasRegression).toBe(false);
+  });
+
+  it('reports failed items, leaves their scores out, and can gate on them', async () => {
+    const a: Row[] = ids(10).map((itemId, i) => ({ itemId, scores: { quality: quality(i), keywords: 0 } }));
+    // B fails on the hard items. One scorer errors on them (no row); another still scores the
+    // empty output, here a perfect 1, as some prebuilt scorers do.
+    const b = ids(10).map((itemId, i): Row =>
+      i >= 7
+        ? { itemId, error: { message: '503 upstream failure' }, scores: { keywords: 1 } }
+        : { itemId, scores: { quality: quality(i), keywords: 0 } },
+    );
+    const result = await compare(mastraWith(a, b));
+    expect(result.failedItems).toEqual({ a: 0, b: 3 });
+    expect(result.scorers.keywords!.statsB.avgScore).toBe(0); // the 1s on failed runs are not counted
+    expect(result.scorers.keywords!.delta).toBe(0);
+    // Each experiment's own mean: B's is over the 7 easy items it completed, so it looks higher.
+    expect(result.scorers.quality!.delta).toBeCloseTo(0.18, 10);
+    expect(result.hasRegression).toBe(false); // not gated unless asked
+    expect(result.warnings).toContain(
+      '3 item(s) failed in experiment B that did not fail in A. A failed run has no comparable score, so score deltas alone can hide this.',
+    );
+
+    const gated = await compare(mastraWith(a, b), { maxFailedItemIncrease: 0 });
+    expect(gated.hasRegression).toBe(true);
+  });
+
+  it('counts newly failed items, not the difference in totals', async () => {
+    // 3 items fail only in A, 3 other items fail only in B: same totals, 3 new failures.
+    const row = (itemId: string, failed: boolean) =>
+      failed ? { itemId, error: { message: 'x' } } : { itemId, scores: { quality: 0.5 } };
+    const a = ids(6).map((itemId, i) => row(itemId, i < 3));
+    const b = ids(6).map((itemId, i) => row(itemId, i >= 3));
+    const result = await compare(mastraWith(a, b), { maxFailedItemIncrease: 0 });
+    expect(result.failedItems).toEqual({ a: 3, b: 3 });
+    expect(result.hasRegression).toBe(true);
+  });
+
+  it('includes failedItems when both experiments are empty', async () => {
+    const result = await compare(mastraWith([], []));
+    expect(result.failedItems).toEqual({ a: 0, b: 0 });
+  });
+
+  it('ignores float noise relative to the score scale', async () => {
+    // A large-scale scorer (e.g. throughput). The three attempts average to A's value exactly in
+    // real numbers, but to A - 1.9e-9 in floating point, which an absolute 1e-9 guard would flag.
+    const a = ids(3).map(itemId => ({ itemId, scores: { throughput: 12345678.9 } }));
+    const b = ids(3).flatMap(itemId =>
+      [12345678.90504, 12345678.90336, 12345678.8916].map((v, attempt) => ({
+        itemId,
+        attempt,
+        scores: { throughput: v },
+      })),
+    );
+    const result = await compare(mastraWith(a, b));
+    expect(result.scorers.throughput!.delta).toBe(0);
+    expect(result.hasRegression).toBe(false);
+  });
+
+  it('an item with one successful attempt is not a failed item', async () => {
+    const a = ids(2).map(itemId => ({ itemId, scores: { quality: 0.5 } }));
+    const b = [
+      { itemId: 'item-1', attempt: 0, error: { message: 'timeout' } },
+      { itemId: 'item-1', attempt: 1, scores: { quality: 0.5 } },
+      { itemId: 'item-2', attempt: 0, scores: { quality: 0.5 } },
+    ];
+    const result = await compare(mastraWith(a, b));
+    expect(result.failedItems).toEqual({ a: 0, b: 0 });
+  });
+});
