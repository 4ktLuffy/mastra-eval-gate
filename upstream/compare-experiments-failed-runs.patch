+type ResultRow = { itemId: string; attempt?: number; error?: unknown };
+
+/**
+ * Items whose target run failed in every attempt (the same rule `finalizeExperiment` uses).
+ */
+function failedItemIds(results: ResultRow[]): Set<string> {
+  const failedByItem = new Map<string, boolean>();
+  for (const result of results) {
+    const failed = result.error != null;
+    failedByItem.set(result.itemId, (failedByItem.get(result.itemId) ?? true) && failed);
+  }
+  return new Set([...failedByItem].filter(([, failed]) => failed).map(([itemId]) => itemId));
+}
+
+/**
+ * Drop scores that belong to a failed run. Experiment scorers still run on a failed target, with
+ * empty input and output, and some score that as perfect, so those scores describe the failure,
+ * not the agent. A score is matched to its attempt by its id (`experimentScoreId`); a score with
+ * another id is matched to its item's only run.
+ */
+function withoutFailedRuns(scores: ScoreRowData[], results: ResultRow[], experimentId: string): ScoreRowData[] {
+  const failedAttempts = new Set<string>();
+  const runsByItem = new Map<string, ResultRow[]>();
+  for (const result of results) {
+    (runsByItem.get(result.itemId) ?? runsByItem.set(result.itemId, []).get(result.itemId)!).push(result);
+    if (result.error != null) {
+      failedAttempts.add(`${result.itemId}#${result.attempt ?? 0}`);
+    }
