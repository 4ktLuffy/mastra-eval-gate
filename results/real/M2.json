    {
      "itemId": "dc4dc2e8-2944-4984-9c54-aa86ea69c78e",
      "text": "The warehouse ends with 105 parcels. 30 + (7 × 11) − 2 = 105.",
      "toolCalls": 1,
      "error": null
    },
    {
      "itemId": "cab1c8e8-59ec-4d49-a619-3063f9fb485e",
      "text": "After discarding 1 coin: 33 − 1 = 32. Keeping one of 4 equal shares: 32 ÷ 4 = 8. Adding crates: 3×7 + 3×4 = 33. Final: 41 coins.",
      "toolCalls": 1,
      "error": null
    },
    {
      "itemId": "c21c0496-31bb-48a8-8257-1ab5df055d5a",
