{
  "name": "mastra-eval-gate",
  "version": "0.2.0",
  "description": "A trustworthy CI gate for Mastra experiments: paired, error-aware comparison with uncertainty.",
  "keywords": [
    "mastra",
    "evals",
    "llm",
    "ci",
    "regression",
    "statistics",
    "agents"
  ],
  "homepage": "https://github.com/4ktLuffy/mastra-eval-gate#readme",
  "bugs": {
    "url": "https://github.com/4ktLuffy/mastra-eval-gate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4ktLuffy/mastra-eval-gate.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    }
  },
  "bin": {
    "mastra-eval-gate": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "FINDINGS.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict --skipLibCheck bench/*.ts test/*.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "@mastra/core": ">=1.74.0",
    "vitest": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mastra/core": "1.74.0",
    "@mastra/evals": "1.10.5",
    "@mastra/libsql": "^1.25.0",
    "@types/node": "^22.0.0",
    "ai": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  }
}
